author = Andrzej Cichocki
build requires += numpy
buildbot enabled = true
devel scripts +=
    $.[curl -L https://github.com/jackaudio/jack2/archive/v1.9.22.tar.gz | tar -C /usr/local/include -xzv --strip-components 2 jack2-1.9.22/common/jack]
    $.[curl https://files.portaudio.com/archives/pa_stable_v190700_20210406.tgz | tar -C /usr/local/include -xzv --strip-components 2 portaudio/include]
github account = combatopera
name = outjack
pypi account = combatopera
pyversions += 3
requires +=
    nativecommon>=4
    numpy>=1.16.6
tagline = JACK and PortAudio integration for Python
years +=
    2017
    2020
